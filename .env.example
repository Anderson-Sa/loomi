# Copie este arquivo para `.env` e preencha os valores.
# Environment variables declared em .env NÃO são carregadas automaticamente pelo Prisma;
# use `import "dotenv/config"` (já feito em prisma/seed.ts) ou o Prisma CLI.

# Banco de dados local (SQLite em arquivo). Para produção, veja o README
# sobre migrar para Postgres — SQLite em arquivo não sobrevive a deploys serverless.
DATABASE_URL="file:./dev.db"

# Chaves de TESTE do Stripe (nunca use chaves de produção aqui).
# Pegue as suas em https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# Gerado ao criar o webhook endpoint em https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=""

# Painel de administração da loja (/admin)
# Gere valores fortes e aleatórios, por exemplo com: openssl rand -hex 32
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# E-mail de confirmação de pedido (Resend — https://resend.com/api-keys).
# Sem essa chave, o pedido continua funcionando normalmente, só não envia e-mail.
RESEND_API_KEY=""
# Opcional: exige domínio verificado na Resend. Sem isso, usa onboarding@resend.dev (só entrega pro seu próprio e-mail de teste).
RESEND_FROM_EMAIL=""

# Login de clientes da loja (/conta)
# Gere um valor forte e aleatório, por exemplo com: openssl rand -hex 32
CUSTOMER_SESSION_SECRET=""

# URL pública do site, usada no sitemap.xml, robots.txt e em tags OpenGraph.
# Sem essa variável, usa http://localhost:3000 (ok em dev, ajuste em produção).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
